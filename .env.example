PORT=3000

# Local docker-compose Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/atm_orbita?schema=public"

# Mail: Resend over SMTP, behind the MailService interface
# (docs/plans/04-fase-1-autenticacion.md, section 7).
# Set MAIL_SMTP_PASSWORD to the Resend API key and MAIL_FROM to a sender on the
# verified domain, e.g. "Orbita <no-reply@mail.atmosferast.com>".
MAIL_TRANSPORT=smtp
MAIL_SMTP_HOST=smtp.resend.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=resend
MAIL_SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
