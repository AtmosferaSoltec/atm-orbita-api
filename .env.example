# Plantilla de variables. Copiala a .env y completa los valores. Nunca subas el .env.

APP_ENV=development
PORT=3001

# Local: localhost:5432. Produccion: host atm-postgres (nombre del contenedor).
DATABASE_URL=

# Auth. Genera cada secreto con: openssl rand -base64 48
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Solo afecta a navegadores (la web). Las apps nativas no usan CORS.
CORS_ORIGIN=

# Limites por IP
RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=5

# Modulos activos (separados por coma)
MODULES_ENABLED=

# Correo (Resend)
RESEND_API_KEY=
MAIL_FROM=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
