# Plantilla de variables. Copiala a .env y completa los valores. Nunca subas el .env.

APP_ENV=development
PORT=3001

# Local: localhost:5432. Produccion: host atm-postgres (nombre del contenedor).
#   Local (docker-compose.dev.yml): postgresql://orbita_app:orbita_dev@localhost:5432/orbita?search_path=orbita
#   Produccion: postgresql://orbita_app:<clave>@atm-postgres:5432/orbita?search_path=orbita
DATABASE_URL=

# Solo en la maquina local, nunca en el servidor: la base contra la que corren las
# pruebas de integracion. go test no lee este archivo: exportala en la terminal.
# Sin ella las pruebas de integracion se saltan, como en el check del despliegue.
#   PowerShell: $env:TEST_DATABASE_URL="postgresql://orbita_app:orbita_dev@localhost:5432/orbita?search_path=orbita"
TEST_DATABASE_URL=

# atm-auth-api: de ahi vienen todos los tokens (RS256). Orbita ya no tiene login propio.
# AUTH_PUBLIC_KEY_BASE64 es la llave publica de auth-api (PEM en base64, la misma de los demas
# servicios) y AUTH_ISSUER su JWT_ISSUER (atm-auth-api). La primera peticion de cada persona crea
# su perfil y sus datos iniciales. auth-api llama a POST /api/v1/internal/auth/user-deleted
# (ACCOUNT_DELETION_HOOKS) antes de borrar una cuenta.
AUTH_PUBLIC_KEY_BASE64=
AUTH_ISSUER=atm-auth-api

# Solo afecta a navegadores (la web). Las apps nativas no usan CORS.
# Produccion: https://orbita.atmosferast.com  (varios separados por coma)
CORS_ORIGIN=

# Limite por IP
RATE_LIMIT_PER_MINUTE=300

# Servicios compartidos de ATM. Orbita los llama con un token de SERVICIO del sistema orbita,
# que pide a auth-api con AUTH_CLIENT_ID + AUTH_CLIENT_SECRET (POST {AUTH_URL}/v1/token) y guarda
# en memoria. Sin AUTH_CLIENT_SECRET el API arranca igual, pero los archivos de los recibos
# responden 503 STORAGE_UNAVAILABLE y el PDF del reporte 503 DOCUMENTS_UNAVAILABLE.
# Las URL tienen valor por defecto (las de produccion); en local apunta a tus servicios de desarrollo.
AUTH_URL=https://auth.atmosferast.com
AUTH_CLIENT_ID=orbita
AUTH_CLIENT_SECRET=
# atm-storage-api: aqui se guardan los XML y PDF de los recibos (ya no hay Cloudflare R2).
STORAGE_API_URL=https://storage.atmosferast.com
# atm-documents-api: genera el PDF del reporte (POST /v1/documents/period-report).
DOCUMENTS_API_URL=https://documents.atmosferast.com
