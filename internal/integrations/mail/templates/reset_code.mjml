<mjml lang="es">
  <mj-head>
    <mj-title>Tu código para recuperar la contraseña</mj-title>
    <mj-preview>Tu código de Orbita es {{.Code}}. Vence en {{.Minutes}} minutos.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#1F2937" font-size="16px" line-height="24px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F3F4F6">
    <mj-section padding="32px 16px 8px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#1D4ED8">Orbita</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" border-radius="16px" padding="24px 16px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700">Recupera tu contraseña</mj-text>
        <mj-text>Escribe este código en la app para crear una contraseña nueva:</mj-text>
        <mj-text align="center" font-size="36px" font-weight="700" letter-spacing="8px" color="#111827" padding="16px 0">{{.Code}}</mj-text>
        <mj-text>Vence en {{.Minutes}} minutos y solo sirve una vez.</mj-text>
        <mj-text color="#6B7280" font-size="14px">Si no lo pediste, ignora este correo: tu contraseña no cambia.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px">
      <mj-column>
        <mj-text align="center" color="#9CA3AF" font-size="12px">Atmósfera Soluciones Tecnológicas</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
