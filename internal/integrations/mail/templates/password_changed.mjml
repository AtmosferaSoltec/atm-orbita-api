<mjml lang="es">
  <mj-head>
    <mj-title>Tu contraseña se cambió</mj-title>
    <mj-preview>La contraseña de tu cuenta de Orbita se cambió.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#1F2937" font-size="16px" line-height="24px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F3F4F6">
    <mj-section padding="32px 16px 8px">
      <mj-column>
        <mj-text font-size="22px" font-weight="700" color="#1D4ED8">Orbita</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFFFFF" border-radius="16px" padding="24px 16px">
      <mj-column>
        <mj-text font-size="20px" font-weight="700">Tu contraseña se cambió</mj-text>
        <mj-text>La contraseña de tu cuenta de Orbita se acaba de cambiar y se cerraron las sesiones abiertas en tus dispositivos.</mj-text>
        <mj-text color="#6B7280" font-size="14px">Si no fuiste tú, recupera tu contraseña desde la app ahora mismo.</mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="16px">
      <mj-column>
        <mj-text align="center" color="#9CA3AF" font-size="12px">Atmósfera Soluciones Tecnológicas</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
